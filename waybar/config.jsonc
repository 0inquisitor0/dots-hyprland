{
    "layer": "bottom",
    "position": "top",
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 10,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["hyprland/language", "cpu", "temperature", "pulseaudio", "battery"],

    "hyprland/workspaces": {
        "format": "{name}",
        "persistent-workspaces": {
            "*": 5 // Это заставит Waybar всегда показывать 5 столов на любом мониторе
        }
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-icons": { "default": ["", "", ""] },
        "format-muted": "muted"
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode"          : "month",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#c0c0c0'><b>{}</b></span>",
                "days":       "<span color='#aaaaaa'>{}</span>",
                "weeks":      "<span color='#999999'>W{}</span>",
                "weekdays":   "<span color='#696969'><b>{}</b></span>",
				"today": "<span color='#444444'><b>{}</b></span>"                
            }
        }
    },
    "hyprland/language": {
        "format": "{short}"
    },
    "cpu": {
        "format": " {usage}%"
    },
    "temperature": {
        "format": " {temperatureC}°C"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "bluetooth": {
        "format": " {status}",
        "format-disabled": " off",
        "format-connected": " {num_connections}",
        "tooltip-format": "{device_alias}",
        "tooltip-format-connected": " {device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "/usr/local/bin/wofi-bluetooth"
    }
}
